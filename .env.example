# ==============================================================================
# MotoTrade AI — variables de entorno (copiar a .env y completar)
# NUNCA subir .env al repositorio. Los secretos viven solo acá o en el gestor de
# secretos del VPS / proveedor cloud.
# ==============================================================================

# --- Entorno ------------------------------------------------------------------
MOTOTRADE_ENV=development            # development | test | production
MOTOTRADE_LOG_LEVEL=INFO

# --- Base de datos ------------------------------------------------------------
# PostgreSQL (producción / docker-compose). Para desarrollo rápido se puede usar
# sqlite:///./mototrade.sqlite3 (no recomendado para producción).
MOTOTRADE_DATABASE_URL=postgresql+psycopg://mototrade:cambiar_esta_clave@db:5432/mototrade
POSTGRES_USER=mototrade
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=mototrade

# --- Reglas de negocio --------------------------------------------------------
# Archivo YAML con límites financieros y fórmulas. La IA NO puede modificarlo:
# solo el operador, y cada tasación registra el hash de la versión usada.
MOTOTRADE_RULES_PATH=config/business_rules.yaml

# --- Seguridad ----------------------------------------------------------------
# Clave para firmar sesiones/tokens (generar con: python -c "import secrets;print(secrets.token_urlsafe(48))")
MOTOTRADE_SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria
# API key para que servicios externos / scripts consuman la API (header X-API-Key)
MOTOTRADE_API_KEY=cambiar_por_otra_clave_aleatoria
# Usuario administrador inicial del panel (se crea con `mototrade create-admin`)
MOTOTRADE_ADMIN_USERNAME=admin
MOTOTRADE_ADMIN_PASSWORD=cambiar_esta_clave_admin

# --- Integraciones (todas opcionales; si falta la credencial, el módulo queda
#     en modo "simulado/deshabilitado" y lo informa en el panel) ---------------
# Telegram: token de @BotFather y chat_id del operador
MOTOTRADE_TELEGRAM_BOT_TOKEN=
MOTOTRADE_TELEGRAM_CHAT_ID=

# IA (Anthropic). Sin clave, el negociador e inspector usan el proveedor "fake".
MOTOTRADE_ANTHROPIC_API_KEY=
MOTOTRADE_LLM_MODEL=claude-sonnet-4-5
MOTOTRADE_LLM_PROVIDER=fake              # fake | anthropic

# Mercado Libre (OAuth de aplicación). PENDIENTE: requiere crear app en el
# portal de desarrolladores y revisar alcance permitido.
MOTOTRADE_MELI_CLIENT_ID=
MOTOTRADE_MELI_CLIENT_SECRET=
MOTOTRADE_MELI_REFRESH_TOKEN=

# Supabase Storage para fotos (nube gratuita). Vacío = disco local (data/photos).
MOTOTRADE_SUPABASE_URL=
MOTOTRADE_SUPABASE_SERVICE_KEY=
MOTOTRADE_SUPABASE_BUCKET=fotos

# --- Worker -------------------------------------------------------------------
MOTOTRADE_WORKER_INTERVAL_SECONDS=300
